# Salin file ini menjadi .env.local lalu isi nilainya.
# Kalau GOOGLE_SHEET_ID / GOOGLE_CLIENT_EMAIL / GOOGLE_PRIVATE_KEY kosong,
# dashboard otomatis memakai DATA DEMO.

# ID spreadsheet: bagian di antara /d/ dan /edit pada URL Google Sheets
GOOGLE_SHEET_ID=

# Dari file JSON service account (field client_email dan private_key)
GOOGLE_CLIENT_EMAIL=
# Tempel private_key apa adanya dalam tanda kutip ganda, termasuk \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Nama tab (sesuaikan kalau berbeda)
SHEET_RESPONS="Form Responses 1"
SHEET_OLAH="Olah"
SHEET_REKAP="Rekap"

# Target assignment per pegawai
TARGET_PER_PEGAWAI=150

# Opsional: kata sandi untuk membuka dashboard (kosongkan jika tidak perlu)
DASHBOARD_PASSWORD=
